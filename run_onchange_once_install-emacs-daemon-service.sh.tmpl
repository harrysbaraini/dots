#!/bin/bash
set -e

mkdir -p "$HOME/Library/LaunchAgents"

PLIST_PATH="$HOME/Library/LaunchAgents/gnu.emacs.daemon.plist"

sudo tee "$PLIST_PATH" > /dev/null << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>gnu.emacs.daemon</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/emacs</string>
        <string>--fg-daemon=/Users/vanderlei/.local/state/emacs/server</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key><true/>
        <key>SuccessfulExit</key><false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/emacs-daemon.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/emacs-daemon.err.log</string>
</dict>
</plist>
EOF

if ! launchctl list | grep -q "gnu.emacs.daemon"; then
    launchctl bootstrap system "$PLIST_PATH"
fi
